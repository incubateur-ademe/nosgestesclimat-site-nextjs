# Local e2e stack — CI-only values. Safe to commit.
# Third-party URLs (Brevo/Connect/Agir/TwoTons/Matomo) are pointed at the mock
# by apps/server/.env.e2e, loaded via `pnpm -F server start:e2e`.

# Server — shared security + non-mocked third-party keys required by the schema
# No NODE_ENV here: the server defaults to development, and the site (next
# build/start) defaults to production.
APP_ENV=development
JWT_SECRET=e2e-jwt-secret
JOB_SECRET=e2e-job-secret
INTERNAL_API_KEY=e2e-internal-api-key
NOTION_API_KEY=e2e
NOTION_ACTION_DATABASE_ID=e2e
SCALEWAY_ACCESS_KEY_ID=e2e
SCALEWAY_SECRET_ACCESS_KEY=e2e
SCALEWAY_BUCKET=e2e

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SERVER_AUTH_COOKIE_NAME=ngc_server_auth_jwt
SESSION_ENCRYPTION_KEY=i2qxSBU1hqZN4xyzSchyKBCqcaIsFecHuQ/NgIDlEoU=
IRON_SESSION_PASSWORD=ci-iron-session-password-32-chars-min
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=PlD/mpIeb55lEYeLFaNOEbR2IAkUdkW528YP/d8jx4c=
LOG_LEVEL=warn
